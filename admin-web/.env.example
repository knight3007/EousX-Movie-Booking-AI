# ==============================================================================
# EousX Admin Web - Environment Configuration Template
# ==============================================================================
# Copy this file to .env or .env.local for local development.
# Note: Vite bundles client-side variables (VITE_*) into the build output.
# NEVER put backend secrets, database credentials, or private API keys here.
# ==============================================================================

# Backend API Base URL (without trailing slash or /api prefix)
VITE_API_BASE_URL=http://localhost:3000
