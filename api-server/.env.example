# ==============================================================================
# EousX API Server - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables for your local or production setup.
# DO NOT commit real secrets or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server & Environment
# ------------------------------------------------------------------------------
PORT=3000
API_HOST_PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# Database (PostgreSQL / Prisma)
# ------------------------------------------------------------------------------
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=<schema>
DATABASE_URL="postgresql://eousx_user:eousx_password@localhost:5432/eousx_db?schema=public"

# ------------------------------------------------------------------------------
# Authentication & JWT
# ------------------------------------------------------------------------------
JWT_SECRET="replace_with_a_long_random_jwt_secret"
JWT_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# Firebase Admin SDK (Google Authentication)
# ------------------------------------------------------------------------------
# Option 1: Path to Firebase service account JSON file (for local development)
FIREBASE_SERVICE_ACCOUNT_PATH="./firebase-service-account.json"

# Option 2: Raw JSON string of service account credentials (for container/cloud deployment)
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'

# Optional: Real Firebase ID token for /auth/google smoke testing
# FIREBASE_TEST_ID_TOKEN=""

# ------------------------------------------------------------------------------
# Google Gemini AI Assistant
# ------------------------------------------------------------------------------
# Backend-orchestrated AI movie assistant (POST /ai/chat)
GEMINI_API_KEY="replace_with_gemini_api_key"

# ------------------------------------------------------------------------------
# SePay Payment Gateway (Test Mode / Lab Environment)
# ------------------------------------------------------------------------------
# Used for QR code generation and incoming webhook confirmation
SEPAY_WEBHOOK_API_KEY="replace_with_sepay_webhook_api_key"
SEPAY_QR_BASE_URL="https://qr.sepay.vn/img"
SEPAY_BANK_CODE="replace_with_bank_code"
SEPAY_BANK_ACCOUNT_NUMBER="replace_with_bank_account_number"
SEPAY_ACCOUNT_NAME="replace_with_account_name"
