<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.EousX" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#F8F1DE</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">#F8F1DE</item>
        <item name="android:colorBackground">#F8F1DE</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#F8F1DE</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/transparent_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.EousX</item>
        <item name="android:windowBackground">#F8F1DE</item>
    </style>
</resources>